# Copy this file to .env and fill in your keys. Never commit .env.

# --- Required: one model API key ------------------------------------------
# Get one at https://console.anthropic.com  (Settings → API keys)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model. Sonnet is the cost/quality sweet spot.
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Or use OpenAI instead ------------------------------------------------
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# --- Optional: free, improves the credit panel ----------------------------
# Free key: https://fredaccount.stlouisfed.org/apikeys
# Without it, the US HY/IG spread instruments are simply omitted.
FRED_API_KEY=

# --- Optional: your live domain, used for canonical URLs and sitemap ------
SITE_URL=https://marketlens.app
